# Generate a secret with the command in docker/README.md. Keep it stable.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example

# Keep HTTPS redirection enabled for hosting.
DJANGO_SECURE_SSL_REDIRECT=1
# Enable only behind a trusted proxy that overwrites X-Forwarded-Proto.
DJANGO_TRUST_PROXY_HEADERS=0

DJANGO_REACT_IMAGE=django-react-starter:latest
APP_PORT=8000
GUNICORN_CMD_ARGS=--workers=2 --timeout=60
